# ── Nvidia API Key (FREE from integrated endpoint) ─────────────────────────────
NVIDIA_API_KEY=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

# ── Gemini API Key (FREE from https://aistudio.google.com/) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Blinkit Location (used to set geolocation in Playwright) ──────────────────
# Default: Bangalore (HSR Layout). Change to your delivery address coords.
BLINKIT_LAT=12.9116
BLINKIT_LNG=77.6370

# ── Browser Profile ────────────────────────────────────────────────────────────
# Persistent Chromium profile directory — stores your Blinkit login session.
BLINKIT_PROFILE_DIR=./browser_profile

# ── Agent Behaviour ────────────────────────────────────────────────────────────
# Set to "true" to skip the interactive confirmation prompt (useful for CI).
AUTO_CONFIRM=false

# ── LLM Settings ──────────────────────────────────────────────────────────────
LLM_MODEL=google/gemma-3n-e2b-it
LLM_MAX_TOKENS=2048
